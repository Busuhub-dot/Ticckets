generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CATEGORY_STAFF
}

enum CategoryCode {
  B
  M
  A
  C
  T
  O
}

enum PaymentStatus {
  UNPAID
  PAID
  CANCELLED
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}


enum AuditAction {
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_REGENERATED
  PAYMENT_UPDATED
  TICKET_SCANNED
  CHECK_IN_REJECTED
  TICKET_CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  ticketsCreated    Ticket[]       @relation("TicketsCreated")
  ticketsScanned    Ticket[]       @relation("TicketsScanned")

  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([role])
}

model Category {
  id   String       @id @default(cuid())
  name String
  code CategoryCode @unique

  users          User[]
  tickets        Ticket[]

  ticketSequence TicketSequence?

  createdAt DateTime @default(now())
}

model TicketSequence {
  id         String @id @default(cuid())
  categoryId String @unique
  nextNumber Int    @default(1)

  category Category @relation(fields: [categoryId],references: [id],onDelete: Cascade)
}

model Ticket {
  id              String        @id @default(cuid())
  ticketNumber    String        @unique
  participantName String
  qrToken         String        @unique

  paymentStatus PaymentStatus @default(UNPAID)
  checkInStatus CheckInStatus @default(NOT_CHECKED_IN)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdById String
  createdBy   User @relation("TicketsCreated",fields: [createdById],references: [id])

  checkedInById String?
  checkedInBy   User? @relation("TicketsScanned",fields: [checkedInById],references: [id])

  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([categoryId])
  @@index([createdById])
  @@index([checkedInById])
  @@index([paymentStatus])
  @@index([checkInStatus])
  @@index([createdAt])
}



model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId],references: [id],onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId],references: [id])

  metadata Json?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}